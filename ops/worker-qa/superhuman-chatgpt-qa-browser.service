[Unit]
Description=Superhuman persistent ChatGPT QA browser
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=superhuman-ai
Group=superhuman-ai
WorkingDirectory=/opt/superhuman/workers/chatgpt-consumer
EnvironmentFile=/etc/superhuman-ai/consumer-worker.env
Environment=HOME=/home/superhuman-ai
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=SUPERHUMAN_DISPLAY_NUMBER=100
Environment=CHATGPT_BROWSER_PROFILE_DIR=/var/lib/superhuman-ai/chatgpt-qa-profile
Environment=CHATGPT_CDP_PORT=9223
ExecStart=/bin/bash /opt/superhuman/workers/chatgpt-consumer/browser-vps.sh
Restart=always
RestartSec=5
TimeoutStopSec=20
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
