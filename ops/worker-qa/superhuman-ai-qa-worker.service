[Unit]
Description=Superhuman autonomous Worker QA harness
After=network-online.target superhuman-chatgpt-qa-browser.service
Requires=superhuman-chatgpt-qa-browser.service
Wants=network-online.target

[Service]
Type=simple
User=superhuman-ai
Group=superhuman-ai
WorkingDirectory=/opt/superhuman/workers/chatgpt-consumer
EnvironmentFile=/etc/superhuman-ai/consumer-worker.env
Environment=SUPERHUMAN_QA_WORKER_ID=superhuman-vps-qa
Environment=SUPERHUMAN_QA_POLL_MS=2500
Environment=SUPERHUMAN_QA_LEASE_SECONDS=1800
Environment=SUPERHUMAN_QA_INTER_ITERATION_PAUSE_MS=1000
Environment=SUPERHUMAN_QA_RATE_LIMIT_COOLDOWN_SECONDS=900
Environment=SUPERHUMAN_QA_MAX_RATE_LIMIT_RETRIES=2
Environment=SUPERHUMAN_CHATGPT_TRAFFIC_KIND=qa
Environment=SUPERHUMAN_QA_BASE_INTERVAL_SECONDS=60
Environment=SUPERHUMAN_CHATGPT_TRAFFIC_LEASE_SECONDS=600
Environment=SUPERHUMAN_CHATGPT_TRAFFIC_MAX_WAIT_MS=600000
Environment=CHATGPT_BROWSER_PROFILE_DIR=/var/lib/superhuman-ai/chatgpt-qa-profile
Environment=CHATGPT_CDP_PORT=9223
Environment=CHATGPT_CDP_URL=http://127.0.0.1:9223
Environment=CHATGPT_REQUIRE_EXISTING_CDP=true
Environment=CHATGPT_HEADLESS=false
Environment=DISPLAY=:100
ExecStart=/bin/bash /opt/superhuman/ops/worker-qa/start.sh
Restart=always
RestartPreventExitStatus=78
RestartSec=5
TimeoutStopSec=210
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/superhuman-ai /opt/superhuman

[Install]
WantedBy=multi-user.target
