[Unit]
Description=Superhuman Next.js frontend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=superhuman-web
Group=superhuman-web
WorkingDirectory=/opt/superhuman-web/current
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
EnvironmentFile=-/opt/superhuman-web/current/.runtime.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3
TimeoutStartSec=30
TimeoutStopSec=20
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
MemoryHigh=600M
MemoryMax=800M
TasksMax=160
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
