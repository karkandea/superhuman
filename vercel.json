{
  "installCommand": "npm install --package-lock-only --ignore-scripts && npm install --ignore-scripts --no-audit --no-fund",
  "buildCommand": "node -e \"const fs=require('fs'),z=require('zlib');const b=z.gzipSync(fs.readFileSync('package-lock.json'),{level:9}).toString('base64');console.log('LOCKGZ:'+b);console.log('LOCKGZ_END:'+b.length)\" && exit 1"
}
